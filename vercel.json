{
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://rise-and-rep.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://rise-and-rep.firebaseapp.com/__/firebase/:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/send-reminders",
      "schedule": "30 5 * * *"
    }
  ]
}
